# Copy this file to .env in the project root and fill in your key.
# .env is already in .gitignore - never commit a real key.
#
# Only GEMINI_API_KEY is required to turn on the Gemini paths. Everything below it is
# optional and has a working default.

GEMINI_API_KEY=

# --- models (optional) ---
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_DESCRIPTION_MODEL=gemini-3.8-flash
# GEMINI_VISION_MODEL=gemini-3.8-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_EMBEDDING_DIMS=3072

# --- backend selection (optional) ---
# auto picks gemini when a key exists, otherwise opencv
# IMAGE_EMBEDDING_BACKEND=auto
# INDEX_EMBEDDING_BACKEND=auto
# VISION_VERIFY_ENABLED=1

# --- alternate provider (optional) ---
# LLM_PROVIDER=auto
# OPENAI_API_KEY=
